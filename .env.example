# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stormleads

# JWT
JWT_SECRET=change-me-to-a-random-string
JWT_REFRESH_SECRET=change-me-to-another-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# Mapbox
VITE_MAPBOX_TOKEN=your-mapbox-public-token

# NOAA (no auth needed, but configurable)
MRMS_S3_BUCKET=noaa-mrms-pds
NWS_API_BASE=https://api.weather.gov
SPC_BASE=https://www.spc.noaa.gov

# Skip Trace (Tracerfy)
TRACERFY_API_KEY=
TRACERFY_API_BASE=https://api.tracerfy.com/v1

# Email Alerts (SMTP — works with SendGrid, Mailgun, Gmail, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StormLeads Alerts" <alerts@stormleads.io>

# Financing (Hearth)
# 32-byte hex key for encrypting lender API keys (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=
# Optional: override Hearth API base URL
HEARTH_API_URL=https://api.gethearth.com/v1
# Public app URL for financing redirect callbacks
APP_URL=http://localhost:5173
